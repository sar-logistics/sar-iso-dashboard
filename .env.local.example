# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://USER:PASS@cluster.mongodb.net/sar_iso?retryWrites=true&w=majority"

# Optional: database name (defaults to sar_iso_dashboard)
# MONGODB_DB="sar_iso_dashboard"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (for user sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated email allowlist
ALLOWED_EMAILS="admin1@example.com,admin2@example.com"

# Google Sheets API (service account, for data sync)
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Vercel Cron security
CRON_SECRET=""
